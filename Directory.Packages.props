<Project>
  <!-- Central package management: every version is pinned here, projects reference packages without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Server">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.9.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="WireMock.Net" Version="2.35.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
